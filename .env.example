# Supabase Database Connections (PGBouncer Transaction Pooler & Direct)
DATABASE_URL="postgresql://postgres.[YOUR_PROJECT_ID]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[YOUR_PROJECT_ID]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# NextAuth / Auth.js Session settings
AUTH_SECRET=""          # Generate with: npx auth secret
NEXTAUTH_URL="http://localhost:3000"

# GitHub OAuth credentials (github.com/settings/developers → OAuth Apps)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Google OAuth credentials (console.cloud.google.com → APIs & Services → Credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Supabase Client Credentials (supabase.com → Project → Settings → API)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Google Gemini API (aistudio.google.com/apikey)
GEMINI_API_KEY=""

# App URL
APP_URL="http://localhost:3000"
